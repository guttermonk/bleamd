[Desktop Entry]
Version=1.0
Type=Application
Name=bleamd
Comment=A powerful standalone Markdown renderer for the terminal
Exec=kitty -- sh -c 'if [ -n "$1" ]; then exec bleamd "$1"; else printf "bleamd: no file specified.\nUsage: bleamd <file.md>\n\nPress Enter to close."; read -r; fi' _ %f
Icon=/usr/local/share/pixmaps/bleamd-icon.svg
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/markdown;text/x-markdown;
Keywords=markdown;viewer;terminal;renderer;